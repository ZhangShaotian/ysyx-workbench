// LW test. RAM and ROM use the same image at base 0x80000000.
// Data starts at byte address 0x80000100 (word index 0x40).
800000b7    // lui x1, 0x80000
10408093    // addi x1, x1, 260  // x1 = 0x80000104
ffc0a103    // lw x2, -4(x1)
0000a183    // lw x3, 0(x1)
0040a203    // lw x4, 4(x1)
00700293    // addi x5, x0, 7
ffc0a003    // lw x0, -4(x1)  // x0 must remain zero
00900313    // addi x6, x0, 9
00100073    // ebreak

@00000040
12345678
89abcdef
fedcba98

// Expected final registers: x0=0x00000000, x1=0x80000104, x2=0x12345678, x3=0x89abcdef, x4=0xfedcba98, x5=0x00000007, x6=0x00000009
// Expected words from 0x80000100: 0x12345678, 0x89abcdef, 0xfedcba98
