// LBU test. RAM and ROM use the same image at base 0x80000000.
// Data starts at byte address 0x80000100 (word index 0x40).
800000b7    // lui x1, 0x80000
10408093    // addi x1, x1, 260  // x1 = 0x80000104
ffc0c103    // lbu x2, -4(x1)
ffd0c183    // lbu x3, -3(x1)
ffe0c203    // lbu x4, -2(x1)
fff0c283    // lbu x5, -1(x1)
0000c303    // lbu x6, 0(x1)
fff00393    // addi x7, x0, -1
fff0c383    // lbu x7, -1(x1)  // overwrite all upper bits with zero
ffe0c003    // lbu x0, -2(x1)  // discard destination
00100413    // addi x8, x0, 1
00100073    // ebreak

@00000040
80ff7f00
12345678

// Expected final registers: x0=0x00000000, x1=0x80000104, x2=0x00000000, x3=0x0000007f, x4=0x000000ff, x5=0x00000080, x6=0x00000078, x7=0x00000080, x8=0x00000001
// Expected words from 0x80000100: 0x80ff7f00, 0x12345678
